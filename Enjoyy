<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Valentine 💖</title>

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Great+Vibes&display=swap" rel="stylesheet">

<style>
*{box-sizing:border-box;}

body{
  margin:0;
  height:100vh;
  overflow:hidden;
  background:linear-gradient(180deg,#ffd6e8,#ff9eb5);
  display:flex;
  justify-content:center;
  align-items:center;
}

/* FLOATING HEARTS */
.heart{
  position:fixed;
  bottom:-20px;
  color:#ff2f92;
  font-size:20px;
  animation:float 6s linear infinite;
  opacity:0.7;
}

@keyframes float{
  0%{transform:translateY(0) scale(1); opacity:0;}
  20%{opacity:0.8;}
  100%{transform:translateY(-100vh) scale(1.4); opacity:0;}
}

/* FADE ANIMATION */
.fade{
  animation:fadeIn 0.9s ease;
}

@keyframes fadeIn{
  from{opacity:0; transform:scale(0.95);}
  to{opacity:1; transform:scale(1);}
}

/* CARD */
.card{
  background:rgba(255,255,255,0.95);
  width:330px;
  padding:28px 22px;
  border-radius:28px;
  text-align:center;
  border:2px solid #ffb3c7;
  box-shadow:0 20px 50px rgba(255,47,146,0.25);
  position:relative;
  z-index:2;
}

img{
  width:100%;
  max-width:210px;
  border-radius:22px;
  margin-bottom:18px;
}

/* TEXT */
.title,.question{
  font-family:'Playfair Display', serif;
  font-size:22px;
  color:#c9184a;
  text-shadow:1px 1px 0 #ffd6e8;
}

.fancy{
  font-family:'Great Vibes', cursive;
  font-size:36px;
  color:#ff2f92;
  text-shadow:2px 2px 0 #ffd6e8;
}

.soft{
  font-family:'Playfair Display', serif;
  color:#6d6875;
  margin-top:6px;
}

.by{
  margin-top:18px;
  font-family:'Great Vibes', cursive;
  font-size:22px;
  color:#c9184a;
}

/* INPUTS & BUTTONS */
input{
  width:90%;
  padding:12px;
  margin:10px 0;
  border-radius:25px;
  border:1.5px solid #ffb3c7;
  font-family:'Playfair Display', serif;
}

button{
  padding:12px 26px;
  border:none;
  border-radius:30px;
  font-family:'Playfair Display', serif;
  cursor:pointer;
}

#continue,#yes{
  background:linear-gradient(135deg,#ff2f92,#ff6fae);
  color:white;
  box-shadow:0 8px 20px rgba(255,47,146,0.4);
}

#no{background:#eee;}

.buttons{
  display:flex;
  justify-content:space-around;
  margin-top:20px;
}

.note{
  margin-top:14px;
  font-size:14px;
  color:#888;
  display:none;
}
</style>
</head>

<body>

<!-- PAGE 1 -->
<div class="card fade" id="page1">
  <img src="https://i.imgur.com/6XGQG5F.png">
  <div class="title">Valentine Setup 💕</div>
  <input id="yourName" placeholder="Your name">
  <input id="valName" placeholder="Valentine name">
  <button id="continue" onclick="goPage2()">Continue 💖</button>
</div>

<!-- PAGE 2 -->
<div class="card fade" id="page2" style="display:none;">
  <div class="question" id="question"></div>
  <div class="buttons">
    <button id="yes" onclick="goPage3()">Yes</button>
    <button id="no" onmouseover="moveNo()">No</button>
  </div>
  <div class="note" id="think">(think about it)</div>
</div>

<!-- PAGE 3 -->
<div class="card fade" id="page3" style="display:none;">
  <img src="https://media.tenor.com/Wx9IEmZZXSoAAAAi/love-cute.gif">
  <div class="fancy">yaayyy 😍</div>
  <div class="soft">u are sooo sweeet 🥰🎀</div>
  <div class="by" id="byName"></div>
</div>

<script>
let yourName="", valName="", noCount=0;

function goPage2(){
  yourName=yourNameInput.value.trim();
  valName=valNameInput.value.trim();
  if(!yourName||!valName){alert("Fill both names 💕");return;}
  page1.style.display="none";
  page2.style.display="block";
  question.innerHTML=`Hey ${valName}, will you be my Valentine? 💖`;
}

function moveNo(){
  noCount++;
  no.style.transform=`translate(${Math.random()*160-80}px,${Math.random()*160-80}px)`;
  if(noCount>=5) think.style.display="block";
}

function goPage3(){
  page2.style.display="none";
  page3.style.display="block";
  byName.innerHTML=`— by ${yourName} 💕`;
}

/* HEART GENERATOR */
setInterval(()=>{
  const h=document.createElement("div");
  h.className="heart";
  h.innerHTML="💖";
  h.style.left=Math.random()*100+"vw";
  h.style.fontSize=(16+Math.random()*20)+"px";
  h.style.animationDuration=(4+Math.random()*3)+"s";
  document.body.appendChild(h);
  setTimeout(()=>h.remove(),7000);
},400);
</script>

</body>
</html>
